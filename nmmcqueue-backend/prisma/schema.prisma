generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  TRIAGE_NURSE
  WINDOW_CLERK
  CLINIC_CALLER
}

enum VisitStatus {
  WAITING_TRIAGE
  IN_TRIAGE
  WAITING_WINDOW
  IN_WINDOW
  WAITING_CLINIC
  IN_PROGRESS
  COMPLETED
  NO_SHOW
}

enum VisitClassification {
  REGULAR
  PRIORITY
}

enum WorkstationType {
  WINDOW
  TRIAGE
  CALLER
}

enum WorkstationQueueMode {
  MIXED
  PRIORITY_ONLY
  REGULAR_ONLY
}

enum DepartmentStatus {
  OPEN
  CLOSED
  FULL
}

model User {
  id              String    @id @default(cuid())
  firstName       String    @db.VarChar(100)
  lastName        String    @db.VarChar(100)
  middleName      String?   @db.VarChar(100)
  suffix          String?   @db.VarChar(20)
  birthDate       DateTime
  contactNumber   String    @db.VarChar(32)
  email           String    @unique @db.VarChar(191)
  emailVerified   Boolean   @default(false)
  employeeID      String    @unique @db.VarChar(64)
  username        String?   @unique @db.VarChar(64)
  displayUsername String?   @db.VarChar(100)
  image           String?
  role            UserRole
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  name            String    @db.VarChar(201)
  department      String?   @db.VarChar(120)
  departmentId    String?
  isActive        Boolean   @default(true)
  accounts        Account[]
  sessions        Session[]
  triagedVisits   Visit[]   @relation("UserTriage")
  calledVisits    Visit[]   @relation("UserCall")
  triageClaimedVisits  Visit[] @relation("TriageClaim")
  windowClaimedVisits  Visit[] @relation("WindowClaim")
  departmentAccess UserDepartmentAccess[]
  dept            Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  workstationId   String?
  workstation     WorkStation? @relation(fields: [workstationId], references: [id])

  @@index([departmentId, role, isActive])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_fkey")
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  providerId            String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_userId_fkey")
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Department {
  id           String       @id @default(cuid())
  name         String       @unique @db.VarChar(120)
  slug         String       @unique @db.VarChar(120)
  code         String       @unique @db.VarChar(32)
  status       DepartmentStatus @default(OPEN)
  videoUrl     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  visits       Visit[]
  referredVisits Visit[]    @relation("DepartmentReferrals")
  users        User[]
  userAccess   UserDepartmentAccess[]
  workstations WorkStation[]
  priorityCategories PriorityCategory[]

  @@map("department")
}

model UserDepartmentAccess {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  isEnabled    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([userId, departmentId])
  @@index([departmentId], map: "userDepartmentAccess_departmentId_fkey")
  @@map("user_department_access")
}

model WorkStation {
  id           String          @id @default(cuid())
  name         String          @unique @db.VarChar(120)
  type         WorkstationType
  queueMode    WorkstationQueueMode @default(MIXED)
  stationNo    Int
  isActive     Boolean         @default(true)
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  parentWorkstationId String?
  parentWorkstation   WorkStation? @relation("WorkstationHierarchy", fields: [parentWorkstationId], references: [id])
  childWorkstations   WorkStation[] @relation("WorkstationHierarchy")
  users           User[]
  originatedVisits Visit[]      @relation("KioskVisits")
  triageVisits     Visit[]      @relation("TriageVisits")
  calledVisits     Visit[]      @relation("CalledAtStation")
  pairedStationId  String?
  pairedStation    WorkStation? @relation("StationPairing", fields: [pairedStationId], references: [id])
  pairings         WorkStation[] @relation("StationPairing")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([type, isActive, stationNo])
  @@map("workstation")
}

model Patient {
  id           String   @id @default(cuid())
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  middleName   String?  @db.VarChar(100)
  dateOfBirth  DateTime
  gender       String   @db.VarChar(16)
  contactNo    String?  @db.VarChar(32)
  address      String?  @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hospitalId   String?  @unique @db.VarChar(64)
  birthPlace   String?  @db.VarChar(100)
  civilStatus  String?  @db.VarChar(20)
  isRegistered Boolean  @default(false)
  religion     String?  @db.VarChar(50)
  visits       Visit[]

  @@map("patient")
}

model Visit {
  id              String      @id @default(cuid())
  patientId           String
  departmentId        String?
  triageTicket        Int?
  serviceTicket       Int?
  sequenceKey         String?     @db.VarChar(64)
  queueBusinessDay    String      @db.VarChar(10)
  kioskRegistrationType String?   @default("UNREGISTERED") @db.VarChar(32)
  status              VisitStatus @default(WAITING_TRIAGE)
  bloodPressure   String?         @db.VarChar(16)
  heartRate       Int?
  respiratoryRate Int?
  temperature     Float?
  oxygenSat       Float?
  hasFever        Boolean     @default(false)
  hasCough        Boolean     @default(false)
  hasColds        Boolean     @default(false)
  hasRashes       Boolean     @default(false)
  isInfectious    Boolean     @default(false)
  chiefComplaint  String?     @db.Text
  medicalHistory  String?     @db.Text
  triageRemarks   String?     @db.Text
  disposition     String?         @db.VarChar(100)
  triagedByUserId String?
  triagedAt       DateTime?
  calledAt        DateTime?
  calledByUserId  String?
  calledAtStationId String?
  windowNumber    Int?
  triageClaimedById  String?
  windowClaimedById  String?
  triageStartedAt    DateTime?
  windowStartedAt    DateTime?
  queueDate       DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  classification  VisitClassification @default(REGULAR)
  hasAppointment  Boolean     @default(false)
  isReferred      Boolean     @default(false)
  referredFromId  String?
  categories      VisitPriorityCategory[]
  referredFrom    Department? @relation("DepartmentReferrals", fields: [referredFromId], references: [id], onDelete: SetNull)
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  patient         Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  triagedByUser   User?       @relation("UserTriage", fields: [triagedByUserId], references: [id], onDelete: SetNull)
  calledByUser    User?       @relation("UserCall", fields: [calledByUserId], references: [id], onDelete: SetNull)
  triageClaimedBy User?       @relation("TriageClaim", fields: [triageClaimedById], references: [id], onDelete: SetNull)
  windowClaimedBy User?       @relation("WindowClaim", fields: [windowClaimedById], references: [id], onDelete: SetNull)
  calledAtStation WorkStation? @relation("CalledAtStation", fields: [calledAtStationId], references: [id], onDelete: SetNull)
  
  originStationId String?
  triageStationId String?
  originStation   WorkStation? @relation("KioskVisits", fields: [originStationId], references: [id], onDelete: SetNull)
  triageStation   WorkStation? @relation("TriageVisits", fields: [triageStationId], references: [id], onDelete: SetNull)

  statusHistory   VisitStatusHistory[]

  @@index([departmentId], map: "visit_departmentId_fkey")
  @@index([patientId], map: "visit_patientId_fkey")
  @@index([triagedByUserId], map: "visit_triagedByUserId_fkey")
  @@index([calledByUserId], map: "visit_calledByUserId_fkey")
  @@index([status, createdAt])
  @@index([patientId, status])
  @@index([departmentId, status, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([classification])
  @@index([status, classification, createdAt])
  @@index([windowNumber, status, createdAt, calledAt])
  @@index([windowClaimedById, status, createdAt])
  @@index([triageClaimedById, status, createdAt])
  @@index([departmentId, status, queueDate])
  @@index([queueBusinessDay, status, createdAt])
  @@index([status, updatedAt])
  @@index([status, queueBusinessDay, calledAt])
  @@index([departmentId, status, queueBusinessDay, calledAt])
  @@index([departmentId, queueBusinessDay, status, isReferred, classification, createdAt])
  @@index([queueBusinessDay, status, classification, createdAt])
  @@index([calledByUserId, departmentId, queueBusinessDay, status])
  @@index([departmentId, queueBusinessDay, status, sequenceKey, calledAt])
  @@unique([queueBusinessDay, classification, triageTicket])
  @@unique([queueBusinessDay, sequenceKey, serviceTicket])
  @@map("visit")
}

model PriorityCategory {
  id           String             @id @default(cuid())
  name         String             @db.VarChar(120)
  code         String             @db.VarChar(32)
  isPriority   Boolean            @default(false)
  templateId   String?
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  template     QueueOptionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  parentId     String?
  parent       PriorityCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     PriorityCategory[] @relation("CategoryHierarchy")
  visits       VisitPriorityCategory[]

  @@unique([departmentId, code])
  @@unique([departmentId, name])
  @@unique([departmentId, templateId])
  @@index([templateId])
  @@index([departmentId, isPriority])
  @@index([isPriority, code])
  @@map("priority_category")
}

model QueueOptionTemplate {
  id         String             @id @default(cuid())
  name       String             @db.VarChar(120)
  code       String             @db.VarChar(32)
  isPriority Boolean            @default(false)
  sortOrder  Int
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  categories PriorityCategory[]

  @@unique([code])
  @@unique([name])
  @@unique([sortOrder])
  @@map("queue_option_template")
}

model VisitPriorityCategory {
  visitId    String
  categoryId String
  visit      Visit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  category   PriorityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([visitId, categoryId])
  @@map("visit_priority_category")
}

model VisitStatusHistory {
  id        String      @id @default(cuid())
  visitId   String
  status    VisitStatus
  changedAt DateTime    @default(now())
  changedBy String?
  visit     Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_status_history")
}

model Sequence {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(64)
  prefix      String?  @db.VarChar(16)
  value       Int      @default(0)
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt

  @@map("sequence")
}
