generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  middleName    String?
  suffix        String?
  birthDate     DateTime
  contactNumber String
  email         String    @unique
  emailVerified Boolean   @default(false)
  employeeID    String    @unique
  image         String?
  role          String
  isApproved    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  name          String
  department    String
  isActive      Boolean   @default(true)
  accounts      Account[]
  sessions      Session[]
  triagedVisits Visit[]   @relation("UserTriage")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_fkey")
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  providerId            String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_userId_fkey")
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Department {
  id           String       @id @default(cuid())
  name         String       @unique
  code         String       @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  queueOptions LaneOption[]
  visits       Visit[]

  @@map("department")
}

model LaneOption {
  id           String     @id @default(cuid())
  departmentId String
  option       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, option])
  @@index([departmentId], map: "lane_option_departmentId_fkey")
  @@map("lane_option")
}

model Patient {
  id           String   @id @default(cuid())
  hospitalId   String?  @unique
  firstName    String
  lastName     String
  middleName   String?
  dateOfBirth  DateTime
  gender       String
  contactNo    String?
  address      String?
  birthPlace   String?
  religion     String?
  civilStatus  String?
  isRegistered Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  visits       Visit[]

  @@map("patient")
}

model Visit {
  id              String      @id @default(cuid())
  patientId       String
  departmentId    String?
  ticketNumber    Int
  status          String      @default("PENDING_TRIAGE")
  priorityClass   String      @default("REGNEW")
  bloodPressure   String?
  heartRate       Int?
  respiratoryRate Int?
  temperature     Float?
  oxygenSat       Float?
  hasFever        Boolean     @default(false)
  hasCough        Boolean     @default(false)
  hasColds        Boolean     @default(false)
  hasRashes       Boolean     @default(false)
  isInfectious    Boolean     @default(false)
  chiefComplaint  String?     @db.Text
  medicalHistory  String?     @db.Text
  triageRemarks   String?     @db.Text
  hasAppointment  Boolean     @default(false)
  disposition     String?
  triagedByUserId String?
  queueDate       DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  department      Department? @relation(fields: [departmentId], references: [id])
  patient         Patient     @relation(fields: [patientId], references: [id])
  triagedByUser   User?       @relation("UserTriage", fields: [triagedByUserId], references: [id])

  @@index([departmentId], map: "visit_departmentId_fkey")
  @@index([patientId], map: "visit_patientId_fkey")
  @@index([triagedByUserId], map: "visit_triagedByUserId_fkey")
  @@map("visit")
}

model Sequence {
  id    String @id @default(cuid())
  name  String @unique
  value Int    @default(0)

  @@map("sequence")
}
