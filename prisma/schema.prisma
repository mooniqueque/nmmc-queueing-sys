// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

//Models

model User {
  //Basic Personal Info for Staff/Employees
  id            String   @id @default(cuid())
  name          String
  firstName     String
  lastName      String
  middleName    String?
  suffix        String?
  birthDate     DateTime
  contactNumber String
  email         String   @unique
  emailVerified Boolean  @default(false)

  //Hospital Data
  employeeID String  @unique
  image      String?
  role       String
  department String
  isApproved Boolean @default(false)
  isActive   Boolean @default(true)

  //Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //BetterAuth connection to say these users own their specific seesions and accounts
  sessions Session[]
  accounts Account[]

  triagedVisits Visit[] @relation("UserTriage")

  @@map("user") //auto small letter naming in sql
}

//BetterAuth Session
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

//BetterAuth Account 
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

//departments
model Department {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  //relations
  visits    Visit[]
  //staff User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("department")
}

//patient profile
model Patient {
  id          String   @id @default(cuid())
  hospitalId  String?  @unique // For returning patients
  firstName   String
  lastName    String
  middleName  String?
  dateOfBirth DateTime
  gender      String
  contactNo   String?
  address     String?

  //relations
  visits    Visit[] //becos patient can have multiple visits over time
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient")
}

model Visit {
  id String @id @default(cuid())

  // Links
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  departmentId String? // Assigned by the Window Clerk, NOT the Triage Nurse
  department   Department? @relation(fields: [departmentId], references: [id])

  // Queue Details
  ticketNumber Int? // Sequence number (assigned by Window Clerk, null until then)
  status       String @default("KIOSK_SUBMITTED") // KIOSK_SUBMITTED, TRIAGED, WAITING_CLINIC, COMPLETED, NO_SHOW

  // --- TRIAGE DATA (From your UI) ---

  // Vitals
  bloodPressure   String? // e.g., "120/80"
  heartRate       Int? // bpm
  respiratoryRate Int? // cpm
  temperature     Float? // °C
  oxygenSat       Float? // %
  // Symptoms & Status
  hasFever        Boolean @default(false)
  hasCough        Boolean @default(false)
  hasColds        Boolean @default(false)
  hasRashes       Boolean @default(false)
  isInfectious    Boolean @default(false)
  // Clinical Notes & Disposition
  chiefComplaint  String? @db.Text
  medicalHistory  String? @db.Text
  triageRemarks   String? @db.Text
  disposition     String? // e.g., "EMERGENT", "URGENT", "NON-URGENT"

  // Staff Link
  triagedByUserId String?
  triagedByUser   User?    @relation("UserTriage", fields: [triagedByUserId], references: [id])
  // NOTE: If you add relation here, you MUST add `triagedVisits Visit[] @relation("UserTriage")` to your User model!
  queueDate       DateTime @default(now()) // To reset ticket counters daily
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("visit")
}
