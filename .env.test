# Dedicated test environment only. Do not point to production.
NODE_ENV=test

# Test backend endpoint used by e2e and integration runners.
TEST_BACKEND_URL=http://localhost:3001
TEST_FRONTEND_URL=http://localhost:3000

# Dedicated MySQL test database (replace placeholders before running DB tests).
DATABASE_URL="mysql://test_user:test_password@127.0.0.1:3306/nmmc_queue_test"

# Optional explicit Prisma URL for test runs.
PRISMA_DATABASE_URL="mysql://test_user:test_password@127.0.0.1:3306/nmmc_queue_test"
