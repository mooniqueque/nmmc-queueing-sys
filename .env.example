# Copy this file to .env and fill in your own values.
# NOTE: Replace the user, password, host, port, and database name with your own.

# allowPublicKeyRetrieval=true is required for MySQL 8.0+ (caching_sha2_password auth plugin)
# when the client does not have the server's RSA public key cached.
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?allowPublicKeyRetrieval=true"
