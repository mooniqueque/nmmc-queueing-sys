{
  "name": "nmmc-queueing-sys",
  "private": true,
  "scripts": {
    "predev": "node scripts/dev-preflight.cjs",
    "dev": "pnpm run predev && pnpm -r --parallel --stream dev",
    "dev:backend": "pnpm --filter nmmcqueue-backend dev",
    "dev:frontend": "pnpm --filter nmmcqueue-frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "postinstall": "pnpm --filter nmmcqueue-backend exec prisma generate"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "@types/pino": "^7.0.5",
    "@types/pino-http": "^6.1.0"
  }
}
