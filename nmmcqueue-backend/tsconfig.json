{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "types": [
            "node",
            "jest"
        ],
        "lib": [
            "es2022"
        ],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "NodeNext",
        "resolveJsonModule": true,
        "isolatedModules": true
    },
    "include": [
        "src/**/*"
    ]
}