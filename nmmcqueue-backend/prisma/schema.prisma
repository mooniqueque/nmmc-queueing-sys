generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  TRIAGE_NURSE
  WINDOW_CLERK
  CLINIC_CALLER
}

enum VisitStatus {
  PENDING_TRIAGE
  KIOSK_SUBMITTED
  WAITING_WINDOW
  WAITING_CLINIC
  IN_PROGRESS
  COMPLETED
  NO_SHOW
}

enum VisitClassification {
  REGULAR
  PRIORITY
}

enum WorkstationType {
  WINDOW
  TRIAGE
  CALLER
  KIOSK
}

model User {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  middleName      String?
  suffix          String?
  birthDate       DateTime
  contactNumber   String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  employeeID      String    @unique
  username        String?   @unique
  displayUsername String?
  image           String?
  role            UserRole
  isApproved      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  name            String
  department      String?
  departmentId    String?
  isActive        Boolean   @default(true)
  accounts        Account[]
  sessions        Session[]
  triagedVisits   Visit[]   @relation("UserTriage")
  calledVisits    Visit[]   @relation("UserCall")
  dept            Department? @relation(fields: [departmentId], references: [id])
  workstationId   String?
  workstation     WorkStation? @relation(fields: [workstationId], references: [id])

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_fkey")
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  providerId            String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_userId_fkey")
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Department {
  id           String       @id @default(cuid())
  name         String       @unique
  slug         String       @unique
  code         String       @unique
  videoUrl     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  visits       Visit[]
  referredVisits Visit[]    @relation("DepartmentReferrals")
  laneOptions LaneOption[]
  users        User[]
  workstations WorkStation[]
  priorityCategories PriorityCategory[]

  @@map("department")
}

model WorkStation {
  id           String          @id @default(cuid())
  name         String          @unique
  type         WorkstationType
  stationNo    Int
  isActive     Boolean         @default(true)
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id])
  users           User[]
  originatedVisits Visit[]      @relation("KioskVisits")
  triageVisits     Visit[]      @relation("TriageVisits")
  calledVisits     Visit[]      @relation("CalledAtStation")
  pairedStationId  String?
  pairedStation    WorkStation? @relation("StationPairing", fields: [pairedStationId], references: [id])
  pairings         WorkStation[] @relation("StationPairing")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("workstation")
}

model Patient {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  middleName   String?
  dateOfBirth  DateTime
  gender       String
  contactNo    String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hospitalId   String?  @unique
  birthPlace   String?
  civilStatus  String?
  isRegistered Boolean  @default(false)
  religion     String?
  visits       Visit[]

  @@map("patient")
}

model Visit {
  id              String      @id @default(cuid())
  patientId       String
  departmentId    String?
  ticketNumber    Int
  status          VisitStatus @default(PENDING_TRIAGE)
  bloodPressure   String?
  heartRate       Int?
  respiratoryRate Int?
  temperature     Float?
  oxygenSat       Float?
  hasFever        Boolean     @default(false)
  hasCough        Boolean     @default(false)
  hasColds        Boolean     @default(false)
  hasRashes       Boolean     @default(false)
  isInfectious    Boolean     @default(false)
  chiefComplaint  String?     @db.Text
  medicalHistory  String?     @db.Text
  triageRemarks   String?     @db.Text
  disposition     String?
  triagedByUserId String?
  triagedAt       DateTime?
  calledAt        DateTime?
  calledByUserId  String?
  calledAtStationId String?
  windowNumber    Int?
  queueDate       DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  classification  VisitClassification @default(REGULAR)
  hasAppointment  Boolean     @default(false)
  isReferred      Boolean     @default(false)
  referredFromId  String?
  categories      VisitPriorityCategory[]
  referredFrom    Department? @relation("DepartmentReferrals", fields: [referredFromId], references: [id])
  department      Department? @relation(fields: [departmentId], references: [id])
  patient         Patient     @relation(fields: [patientId], references: [id])
  triagedByUser   User?       @relation("UserTriage", fields: [triagedByUserId], references: [id])
  calledByUser    User?       @relation("UserCall", fields: [calledByUserId], references: [id])
  calledAtStation WorkStation? @relation("CalledAtStation", fields: [calledAtStationId], references: [id])
  
  originStationId String?
  triageStationId String?
  originStation   WorkStation? @relation("KioskVisits", fields: [originStationId], references: [id])
  triageStation   WorkStation? @relation("TriageVisits", fields: [triageStationId], references: [id])

  statusHistory   VisitStatusHistory[]

  @@index([departmentId], map: "visit_departmentId_fkey")
  @@index([patientId], map: "visit_patientId_fkey")
  @@index([triagedByUserId], map: "visit_triagedByUserId_fkey")
  @@index([calledByUserId], map: "visit_calledByUserId_fkey")
  @@index([status, createdAt])
  @@index([patientId, status])
  @@index([departmentId, status, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([classification])
  @@unique([queueDate, ticketNumber])
  @@map("visit")
}

model PriorityCategory {
  id           String             @id @default(cuid())
  name         String
  code         String
  isPriority   Boolean            @default(false)
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id])
  parentId     String?
  parent       PriorityCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     PriorityCategory[] @relation("CategoryHierarchy")
  visits       VisitPriorityCategory[]

  @@unique([departmentId, code])
  @@map("priority_category")
}

model VisitPriorityCategory {
  visitId    String
  categoryId String
  visit      Visit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  category   PriorityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([visitId, categoryId])
  @@map("visit_priority_category")
}

model VisitStatusHistory {
  id        String      @id @default(cuid())
  visitId   String
  status    VisitStatus
  changedAt DateTime    @default(now())
  changedBy String?
  visit     Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_status_history")
}

model Sequence {
  id          String   @id @default(cuid())
  name        String   @unique
  prefix      String?
  value       Int      @default(0)
  description String?
  updatedAt   DateTime @updatedAt

  @@map("sequence")
}

model LaneOption {
  id           String     @id @default(cuid())
  departmentId String
  option       String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, option])
  @@index([departmentId], map: "laneOption_departmentId_fkey")
  @@map("lane_option")
}
