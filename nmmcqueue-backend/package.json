{
    "name": "nmmcqueue-backend",
    "version": "1.0.0",
    "description": "Express Backend for NMMC Queueing System",
    "main": "src/server.ts",
    "scripts": {
        "start": "node dist/server.js",
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "db:inspect": "node scripts/inspect-all-db.cjs",
        "db:verify": "node scripts/verify-schema-columns.cjs",
        "db:migrate:status": "prisma migrate status",
        "db:migrate:deploy": "prisma migrate deploy"
    },
    "dependencies": {
        "@nmmc/types": "workspace:*",
        "@prisma/adapter-mariadb": "^7.4.2",
        "@prisma/client": "^7.4.2",
        "@thiagoelg/node-printer": "^0.6.2",
        "@types/express-rate-limit": "^6.0.2",
        "@types/multer": "^2.1.0",
        "better-auth": "^1.4.19",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "multer": "^2.1.1",
        "node-thermal-printer": "^4.6.0",
        "winston": "^3.19.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@prisma/config": "^7.4.2",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.12.7",
        "prisma": "^7.4.2",
        "tsx": "^4.21.0",
        "typescript": "^5.4.5"
    }
}